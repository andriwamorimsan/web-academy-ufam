{
  "type": "module",
  "scripts": {
    "start": "nodemon --watch src --watch views --exec tsx src/index.ts",
    "build": "tsc",
    "start:prod": "node build/src/index.js",
    "start:db": "json-server --watch data/db.json --port 3355",
    "lint": "eslint src/",
    "lint:fix": "npx eslint --fix src/",
    "format": "prettier --write src/",
    "sass": "sass sass/main.scss public/css/main.css --watch",
    "sass:build": "sass sass/main.scss public/css/main.css"
  },
  "dependencies": {
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "json-server": "^1.0.0-beta.15",
    "lorem-ipsum": "^3.0.0",
    "method-override": "^3.0.0",
    "morgan": "^1.11.0",
    "sass": "^1.100.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/method-override": "^3.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
