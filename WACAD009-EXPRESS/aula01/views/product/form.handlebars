<h1>{{title}}</h1>

<form class="product-form" action="{{action}}" method="post">
  <div class="mb-3">
    <label class="form-label" for="nome">Nome</label>
    <input class="form-control" id="nome" name="nome" type="text" value="{{product.nome}}" required>
  </div>
  <div class="mb-3">
    <label class="form-label" for="preco">Preco</label>
    <input class="form-control" id="preco" name="preco" type="number" min="0" step="0.01" value="{{product.preco}}" required>
  </div>
  <div class="mb-3">
    <label class="form-label" for="estoque">Estoque</label>
    <input class="form-control" id="estoque" name="estoque" type="number" min="0" step="1" value="{{product.estoque}}" required>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-primary" type="submit">{{buttonLabel}}</button>
    <a class="btn btn-outline-secondary" href="/product">Cancelar</a>
  </div>
</form>
